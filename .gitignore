# Local .terraform directories
**/.terraform/*

# State files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files that may contain sensitive data
# (passwords, API keys, etc.)
*.tfvars
*.tfvars.json

# Override files, usually used for local dev tweaks
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Plan output files
*.tfplan
tfplan

# Optional: ignore generated docs/graph output
*.dot

# Editor / OS files
.idea/
.vscode/
*.swp
.DS_Store